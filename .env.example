APP_NAME="Laravel Search Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_search_demo
DB_USERNAME=postgres
# REQUIRED: password of the DB_USERNAME account above.
DB_PASSWORD=

# Read-only connection used by the autocomplete search path.
# SEARCH_DB_PASSWORD is REQUIRED: choose a strong password. The role migration
# creates the search_reader role with it and refuses to run when it is empty.
SEARCH_DB_CONNECTION=pgsql_search
SEARCH_DB_HOST=127.0.0.1
SEARCH_DB_PORT=5432
SEARCH_DB_DATABASE=laravel_search_demo
SEARCH_DB_USERNAME=search_reader
SEARCH_DB_PASSWORD=
# Reuse the read-only connection inside the worker (recommended).
SEARCH_DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use "redis" when a Redis server and the phpredis/predis client are available.
CACHE_STORE=database
CACHE_PREFIX=searchdemo

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Search / billing configuration
# ---------------------------------------------------------------------------
SEARCH_MIN_TOKEN_LENGTH=3
SEARCH_MAX_QUERY_LENGTH=100
SEARCH_MAX_TOKENS=6
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=20
SEARCH_CANDIDATE_CAP=200
SEARCH_FILTER_CANDIDATE_CAP=200
SEARCH_CACHE_ENABLED=true
# Empty uses CACHE_STORE. Set to "redis" together with CACHE_STORE=redis.
SEARCH_CACHE_STORE=
SEARCH_CACHE_TTL=600
SEARCH_CACHE_PREFIX=ac:v1
API_CLIENT_CACHE_TTL=300

# PostgreSQL role settings applied by the role migration.
SEARCH_DB_STATEMENT_TIMEOUT=250ms

# REQUIRED: 32+ random bytes. Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
SELECTION_TOKEN_SECRET=
SELECTION_TOKEN_TTL=600

SEARCH_RATE_LIMIT=120
SELECT_RATE_LIMIT=60

# Filled in by: php artisan api-client:create "Demo Client" --publish
# (the demo UI at / needs it; leave empty until that command has run)
DEMO_API_KEY=

# Optional: Laravel Octane (RoadRunner) for load tests. Not needed for `php artisan serve`.
OCTANE_SERVER=roadrunner
